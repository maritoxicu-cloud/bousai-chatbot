# Supabase Configuration
# Get these from https://supabase.com/dashboard/projects
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-api-key-here

# Security Settings
DEBUG_MODE=false
ALLOWED_ORIGINS=https://bousai-chatbot.vercel.app,http://localhost:3000

# API Authentication
# Generate a secure API key for production use
API_KEY=your-secure-api-key-here
